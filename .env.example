# =====================================================================
# Copie este arquivo para .env e ajuste os valores:
#     cp .env.example .env
# O .env NUNCA deve ser versionado (já está no .gitignore).
# =====================================================================

# --- Banco de dados do projeto (container postgres-data) ---
# Rodando o pipeline fora do Docker: localhost
# Rodando dentro do Docker Compose: postgres-data (nome do serviço)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_monitor
POSTGRES_USER=fhm_user
POSTGRES_PASSWORD=troque_esta_senha

# --- Mercado ---
MARKET_TIMEZONE=America/Sao_Paulo

# --- Extração ---
EXTRACTION_LOOKBACK_DAYS=400
API_TIMEOUT_SECONDS=20
API_MAX_RETRIES=3
API_RETRY_BACKOFF_SECONDS=2
API_PAUSE_BETWEEN_TICKERS=1

# --- Logging: DEBUG, INFO, WARNING, ERROR ---
LOG_LEVEL=INFO

# --- Opcionais (padrão: relativo à raiz do projeto) ---
# TICKERS_FILE=config/tickers.yaml
# DATA_DIR=data